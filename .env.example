# Copy to .env locally. Never commit the real .env file.
DATA_GO_KR_SERVICE_KEY=

# Add only if/when VWorld is selected as the boundary adapter.
VWORLD_API_KEY=

# PERSONAL is the default. COMMERCIAL restricts sources independently.
BUDONG_USE_MODE=PERSONAL
# Optional reviewed HTTPS tile template; no secret/query parameters.
# BUDONG_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# For another provider, review its display/hosting terms and attribution first.
# BUDONG_TILE_REVIEWED=true
# BUDONG_TILE_ATTRIBUTION=Provider-required attribution text
